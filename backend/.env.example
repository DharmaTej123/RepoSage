# Copy to backend/.env and adjust as needed. All vars are REPOSAGE_-prefixed.
REPOSAGE_ENVIRONMENT=development
REPOSAGE_DEBUG=true

# Datastores
REPOSAGE_DATABASE_URL=postgresql+psycopg://reposage:reposage@localhost:5432/reposage
REPOSAGE_NEO4J_URI=bolt://localhost:7687
REPOSAGE_NEO4J_USER=neo4j
REPOSAGE_NEO4J_PASSWORD=reposage
REPOSAGE_REDIS_URL=redis://localhost:6379/0

# Working directory for immutable per-run repo snapshots
REPOSAGE_WORKDIR_ROOT=./.reposage/workdir

# Ingestion limits
REPOSAGE_MAX_REPO_SIZE_MB=1024

# Git history
REPOSAGE_HISTORY_WINDOW_DAYS=730
REPOSAGE_RECENT_ACTIVITY_DAYS=365

# Thresholds
REPOSAGE_BUS_FACTOR_THRESHOLD=0.80
REPOSAGE_COVERAGE_GAP_THRESHOLD=0.50
REPOSAGE_STALENESS_MONTHS=18

# Sandbox
REPOSAGE_SANDBOX_CPU_LIMIT=2.0
REPOSAGE_SANDBOX_MEMORY_MB=2048
REPOSAGE_SANDBOX_TIMEOUT_SECONDS=600
REPOSAGE_SANDBOX_PIDS_LIMIT=256

# LLM / observability
REPOSAGE_LLM_MAX_TOKENS_PER_RUN=200000
REPOSAGE_LANGSMITH_TRACING=false
REPOSAGE_LANGSMITH_PROJECT=reposage
